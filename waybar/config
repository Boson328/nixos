{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 2,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "custom/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "backlight",
        "network",
        "pulseaudio",
        "battery",
        "hyprland/language",
        "custom/power"
    ],

    "custom/workspaces": {
        "exec": "~/.local/bin/niri-workspaces",
        "return-type": "json",
        "format": "{}",
        "escape": false
    },

    "clock": {
        "format": "  {:%H:%M:%S}",
        "format-alt": "  {:%Y年%m月%d日}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1
    },

    "cpu": {
        "format": "󰻠  {usage}%",
        "tooltip": true,
        "interval": 2
    },

    "memory": {
        "format": "󰍛  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 2
    },

    "backlight": {
        "format": "  {percent}",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set -5%",
    },

    "network": {
        "format-wifi": "󰤨  {signalStrength}%",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰤭  切断",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "未接続"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  ミュート",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power:.1f}W"
    },

    "hyprland/language": {
        "format": "  {}",
        "format-en": "en",
        "format-ja": "ja"
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "niri msg action quit",
        "tooltip": false
    }
}
